msgid "API Base URL//Leave as https://pay.getpayin.com unless you were given a dedicated PayLink domain."
msgstr ""

msgid "Authentication Token//Copy it from Settings &rarr; Payment Integrations in your PayLink dashboard."
msgstr ""

msgid "Consent Text//Shown to the payer when they authorise recurring charges. Required for recurring payments."
msgstr ""

msgid "Hash Token//The signing secret from the same screen. It is used to sign requests and verify webhooks, and never leaves your server."
msgstr ""

msgid "I authorise recurring charges for this subscription."
msgstr ""

msgid "Installments//Offer fixed installments on the PayLink checkout. Requires installments enabled on your account."
msgstr ""

msgid "Number of Installments//Between 2 and 24. Used only when installments are enabled above."
msgstr ""

msgid "Pay Now"
msgstr ""

msgid "Payment Action//Capture charges immediately. Authorize places a hold to capture later, and requires authorize mode enabled on your account."
msgstr ""

msgid "Payment Type//One-off takes a single payment. Recurring creates a subscription mandate and charges the order total every cycle."
msgstr ""

msgid "Recurring Interval Count//How many intervals between charges. 1 with a monthly interval means once a month."
msgstr ""

msgid "Recurring Interval//The billing period for recurring payments."
msgstr ""

msgid "Redirecting you to the secure PayLink checkout&hellip;"
msgstr ""

msgid "Thank you! Your payment was received."
msgstr ""

msgid "Total Cycles//Optional. Stop after this many charges. Leave empty for an open-ended subscription."
msgstr ""

msgid "We could not start the PayLink checkout. Please try again or contact the store."
msgstr ""

msgid "We could not verify your payment. Please try again."
msgstr ""
